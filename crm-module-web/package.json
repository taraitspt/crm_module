{
  "name": "crm-module-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:e2e": "npx playwright test e2e/00-full-server-test.spec.ts --reporter=list",
    "test:e2e:ui": "npx playwright test --ui",
    "app:sync": "cap sync",
    "app:android": "cap sync android && cd android && gradlew.bat assembleDebug && cd .. && node scripts/copy-apk.cjs",
    "app:assets": "capacitor-assets generate --iconBackgroundColor #FFFFFF --iconBackgroundColorDark #003957 --splashBackgroundColor #FFFFFF --splashBackgroundColorDark #003957"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-table": "^8.16.0",
    "antd": "^5.16.0",
    "axios": "^1.6.8",
    "dayjs": "^1.11.11",
    "exceljs": "^4.4.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
